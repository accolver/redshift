{
	"name": "redshift",
	"version": "0.14.2",
	"description": "Decentralized, censorship-resistant secret management platform",
	"type": "module",
	"private": true,
	"workspaces": ["packages/*", "web"],
	"overrides": {
		"cookie": "0.7.2",
		"esbuild": "0.28.1",
		"picomatch": "4.0.5",
		"postcss": "8.5.16",
		"rollup": "4.62.2",
		"undici": "7.28.0",
		"ws": "8.21.0"
	},
	"bin": {
		"redshift": "./dist/redshift"
	},
	"scripts": {
		"dev": "bun run cli/src/main.ts",
		"dev:web": "cd web && bun run dev",
		"build": "bun run build:web && bun run build:embeds && bun run build:cli",
		"build:embeds": "bun run cli/scripts/generate-embeds.ts",
		"verify:embeds": "bun run cli/scripts/generate-embeds.ts --check-source",
		"build:cli": "bun build cli/src/main.ts --compile --outfile dist/redshift",
		"build:cli:all": "bun run build:cli:darwin-arm64 && bun run build:cli:darwin-x64 && bun run build:cli:linux-arm64 && bun run build:cli:linux-x64",
		"build:cli:darwin-arm64": "bun build cli/src/main.ts --compile --target=bun-darwin-arm64 --outfile dist/redshift-darwin-arm64",
		"build:cli:darwin-x64": "bun build cli/src/main.ts --compile --target=bun-darwin-x64 --outfile dist/redshift-darwin-x64",
		"build:cli:linux-arm64": "bun build cli/src/main.ts --compile --target=bun-linux-arm64 --outfile dist/redshift-linux-arm64",
		"build:cli:linux-x64": "bun build cli/src/main.ts --compile --target=bun-linux-x64 --outfile dist/redshift-linux-x64",
		"build:web": "cd web && bun run build",
		"build:all": "bun run build:web && bun run build:embeds && bun run build:cli:all",
		"test": "bun run test:cli && bun run test:web",
		"test:cli": "cd cli && bun test",
		"test:web": "cd web && bun run test",
		"test:crypto": "cd packages/crypto && bun test",
		"test:rate-limiter": "cd packages/rate-limiter && bun test",
		"test:all": "bun run test:crypto && bun run test:rate-limiter && bun run test:cli && bun run test:web",
		"test:fuzz": "bun test tests/helpers/fuzz.test.ts packages/crypto/tests/fuzz.test.ts packages/rate-limiter/tests/fuzz.test.ts cli/tests/commands/secrets-fuzz.test.ts && (cd web && bun run test:fuzz) && (cd relay/nosflare && bun run test:fuzz)",
		"test:fuzz:extended": "REDSHIFT_FUZZ_RUNS=${REDSHIFT_FUZZ_RUNS:-5000} REDSHIFT_FUZZ_TIME_MS=${REDSHIFT_FUZZ_TIME_MS:-120000} bun run test:fuzz",
		"audit:dependencies": "bun audit --audit-level=low && cd relay/nosflare && bun audit --audit-level=low",
		"test:production": "bash scripts/verify-production-readiness.sh",
		"test:release:containers": "bash scripts/test-release-containers.sh",
		"generate:nsec": "bun run cli/scripts/generate-test-nsec.ts",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"typecheck": "tsc --noEmit",
		"typecheck:packages": "cd packages/crypto && bun run typecheck && cd ../rate-limiter && bun run typecheck",
		"typecheck:web": "cd web && bun run check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"release:prepare": "bun run build:all && bun run test:all",
		"release:list": "ls -lah dist/",
		"version:bump": "npm version --no-git-tag-version"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/bun": "latest",
		"fast-check": "4.9.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@redshift/crypto": "workspace:*",
		"@redshift/rate-limiter": "workspace:*",
		"nostr-tools": "^2.23.9",
		"qrcode-terminal": "^0.12.0",
		"yaml": "^2.9.0"
	},
	"keywords": [
		"secrets",
		"nostr",
		"decentralized",
		"cli",
		"doppler",
		"environment-variables",
		"test"
	],
	"author": "",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": ""
	}
}
