#!/bin/sh
# Redshift CLI Installer
# Usage: curl -fsSL https://redshiftapp.com/install | sh

set -e

REPO="accolver/redshift"
BINARY_NAME="redshift"
INSTALL_DIR="${REDSHIFT_INSTALL_DIR:-$HOME/.local/bin}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() {
    printf "${BLUE}info${NC} %s\n" "$1"
}

success() {
    printf "${GREEN}success${NC} %s\n" "$1"
}

warn() {
    printf "${YELLOW}warn${NC} %s\n" "$1"
}

error() {
    printf "${RED}error${NC} %s\n" "$1"
    exit 1
}

# Detect OS
detect_os() {
    case "$(uname -s)" in
        Linux*)     OS="linux";;
        Darwin*)    OS="darwin";;
        MINGW*|MSYS*|CYGWIN*) error "Windows binaries are not currently published";;
        *)          error "Unsupported operating system: $(uname -s)";;
    esac
}

# Detect architecture
detect_arch() {
    case "$(uname -m)" in
        x86_64|amd64)   ARCH="x64";;
        arm64|aarch64)  ARCH="arm64";;
        *)              error "Unsupported architecture: $(uname -m)";;
    esac
}

# Get latest release version from GitHub
get_latest_version() {
    VERSION=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/')
    if [ -z "$VERSION" ]; then
        error "Failed to fetch latest version from GitHub"
    fi
    if ! printf '%s' "$VERSION" | grep -Eq '^v?[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$'; then
        error "GitHub returned an invalid release tag"
    fi
}

# Download, verify, and atomically install binary
install_binary() {
    if ! command -v gh >/dev/null 2>&1; then
        error "GitHub CLI (gh) is required to verify the release attestation"
    fi

    ASSET_NAME="${BINARY_NAME}-${OS}-${ARCH}"
    BINARY_PATH="${INSTALL_DIR}/${BINARY_NAME}"
    DOWNLOAD_URL="https://github.com/${REPO}/releases/download/${VERSION}/${ASSET_NAME}"
    mkdir -p "$INSTALL_DIR" || error "Failed to create install directory"
    # The candidate must be on the destination filesystem so mv remains atomic.
    TEMP_BINARY=$(mktemp "${INSTALL_DIR}/.redshift.XXXXXX") || error "Failed to create temporary file"
    CHECKSUM_FILE="${TEMP_BINARY}.checksums.txt"
    trap 'rm -f "$TEMP_BINARY" "$CHECKSUM_FILE"' EXIT HUP INT TERM

    info "Downloading Redshift ${VERSION} for ${OS}/${ARCH}..."
    if ! curl -fsSL "$DOWNLOAD_URL" -o "$TEMP_BINARY"; then
        error "Failed to download binary from $DOWNLOAD_URL"
    fi
    if ! curl -fsSL "https://github.com/${REPO}/releases/download/${VERSION}/checksums.txt" -o "$CHECKSUM_FILE"; then
        error "Failed to download trusted checksum manifest"
    fi

    info "Resolving release source identity..."
    if ! SOURCE_DIGEST=$(gh api "repos/${REPO}/commits/${VERSION}" --jq .sha); then
        error "Failed to resolve the release source digest"
    fi
    if ! printf '%s' "$SOURCE_DIGEST" | grep -Eq '^[0-9a-f]{40}([0-9a-f]{24})?$'; then
        error "GitHub returned an invalid release source digest"
    fi

    info "Verifying GitHub artifact attestation..."
    if ! gh attestation verify "$TEMP_BINARY" \
        --repo "$REPO" \
        --signer-workflow "${REPO}/.github/workflows/release.yml" \
        --source-digest "$SOURCE_DIGEST" \
        --deny-self-hosted-runners >/dev/null; then
        error "Release attestation verification failed; refusing to install"
    fi
    if ! gh attestation verify "$CHECKSUM_FILE" \
        --repo "$REPO" \
        --signer-workflow "${REPO}/.github/workflows/release.yml" \
        --source-digest "$SOURCE_DIGEST" \
        --deny-self-hosted-runners >/dev/null; then
        error "Checksum manifest attestation verification failed; refusing to install"
    fi

    EXPECTED_HASH=$(awk -v asset="$ASSET_NAME" '
        $2 == asset { count += 1; hash = $1 }
        END { if (count == 1) print hash }
    ' "$CHECKSUM_FILE")
    if ! printf '%s' "$EXPECTED_HASH" | grep -Eq '^[0-9a-f]{64}$'; then
        error "Trusted manifest must contain exactly one canonical checksum for $ASSET_NAME"
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        ACTUAL_HASH=$(sha256sum "$TEMP_BINARY" | awk '{print $1}')
    else
        ACTUAL_HASH=$(shasum -a 256 "$TEMP_BINARY" | awk '{print $1}')
    fi
    if [ "$ACTUAL_HASH" != "$EXPECTED_HASH" ]; then
        error "Downloaded binary checksum verification failed"
    fi

    chmod +x "$TEMP_BINARY"
    if ! "$TEMP_BINARY" --version >/dev/null 2>&1; then
        error "Downloaded binary failed its smoke test; refusing to install"
    fi
    mv -f "$TEMP_BINARY" "$BINARY_PATH"
    rm -f "$CHECKSUM_FILE"
    trap - EXIT HUP INT TERM

    success "Installed verified Redshift binary to $BINARY_PATH"
}

# Check if install directory is in PATH
check_path() {
    case ":$PATH:" in
        *":$INSTALL_DIR:"*)
            ;;
        *)
            warn "$INSTALL_DIR is not in your PATH"
            echo ""
            echo "Add it to your shell profile:"
            echo ""
            echo "  # For bash (~/.bashrc or ~/.bash_profile)"
            echo "  export PATH=\"\$PATH:$INSTALL_DIR\""
            echo ""
            echo "  # For zsh (~/.zshrc)"
            echo "  export PATH=\"\$PATH:$INSTALL_DIR\""
            echo ""
            echo "  # For fish (~/.config/fish/config.fish)"
            echo "  fish_add_path $INSTALL_DIR"
            echo ""
            ;;
    esac
}

# Main installation flow
main() {
    echo ""
    echo "  ╔═══════════════════════════════════════╗"
    echo "  ║   Redshift - Secret Management CLI    ║"
    echo "  ║   Decentralized. Censorship-free.     ║"
    echo "  ╚═══════════════════════════════════════╝"
    echo ""

    detect_os
    detect_arch
    get_latest_version
    install_binary
    check_path

    echo ""
    success "Installation complete!"
    echo ""
    echo "Get started:"
    echo "  redshift login      # Authenticate with your Nostr identity"
    echo "  redshift setup      # Configure a project"
    echo "  redshift --help     # See all commands"
    echo ""
    echo "Documentation: https://redshiftapp.com/docs"
    echo ""
}

main
